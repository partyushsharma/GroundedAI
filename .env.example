# Copy to .env and fill in. .env is git-ignored and must stay that way --
# doctor.py fails loudly if it ever becomes tracked.

# --- Runtime flags -------------------------------------------------------
# faiss and torch each vendor their own libomp; without this macOS aborts the
# process when the second one loads.
KMP_DUPLICATE_LIB_OK=TRUE
# Lets unimplemented MPS operators fall back to CPU instead of raising.
PYTORCH_ENABLE_MPS_FALLBACK=1

# --- LLM providers (both free tiers, no card required) -------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
